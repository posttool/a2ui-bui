       "@path": "/drones"
      },
      "icons": [
       "DRONE",
       "DRONE",
       "DRONE"
      ],
      "rows": 3,
      "selected": {
       "@path": "/drone_sel"
      },
      "weight": 1,
      "action": {
       "event": {
        "name": "drone_select",
        "context": {
         "index": {
          "@path": "/drone_sel"
         }
        }
       }
      }
     },
     {
