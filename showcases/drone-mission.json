{
 "name": "Drone mission planner",
 "window": "Mission Planner",
 "width": 1150,
 "description": "Not Blender: waypoints templated from /waypoints inside a ScrollView (VectorField with custom ENU axes, speed and hold fields, action Dropdown with icons), a NormalBall gimbal, a drone ListView with battery ProgressBar and a mission map Image.",
 "messages": [
  {
   "version": "v1.0",
   "createSurface": {
    "surfaceId": "main",
    "catalogId": "https://a2ui-bui-demo.local/catalogs/bui/v1/catalog.json",
    "sendDataModel": true
   }
  },
  {
   "version": "v1.0",
   "updateComponents": {
    "surfaceId": "main",
    "components": [
     {
      "id": "label_1",
      "component": "Label",
      "text": {
       "@path": "name"
      },
      "icon": "PIN",
      "bold": true
     },
     {
      "id": "spacer_2",
      "component": "Spacer"
     },
     {
      "id": "dropdown_3",
      "component": "Dropdown",
      "value": {
       "@path": "action"
      },
      "items": [
       "Fly through",
       "Hover",
       "Take photo",
       "Survey grid",
       "Land"
      ],
      "icons": [
       "ROUTE",
       "TIMER",
       "CAMERA",
       "MOD_LATTICE",
       "DRONE"
      ]
     },
     {
      "id": "iconButton_4",
      "component": "IconButton",
      "icon": "X",
      "action": {
       "event": {
        "name": "waypoint_remove",
        "context": {
         "name": {
          "@path": "name"
         }
        }
       }
      }
     },
     {
      "id": "row_5",
      "component": "Row",
      "children": [
       "label_1",
       "spacer_2",
       "dropdown_3",
       "iconButton_4"
      ]
     },
     {
      "id": "vectorField_6",
      "component": "VectorField",
      "label": "Position",
      "value": {
       "@path": "pos"
      },
      "axes": "ENU",
      "suffix": " m",
      "precision": 1,
      "action": {
       "event": {
        "name": "waypoint_move",
        "context": {
         "name": {
          "@path": "name"
         },
         "pos": {
          "@path": "pos"
         }
        }
       }
      }
     },
     {
      "id": "numberField_7",
      "component": "NumberField",
      "label": "Speed",
      "value": {
       "@path": "speed"
      },
      "suffix": " m/s",
      "min": 0,
      "max": 20,
      "precision": 1
     },
     {
      "id": "numberField_8",
      "component": "NumberField",
      "label": "Hold",
      "value": {
       "@path": "hold"
      },
      "suffix": " s",
      "min": 0,
      "precision": 0,
      "integer": true
     },
     {
      "id": "row_9",
      "component": "Row",
      "children": [
       "numberField_7",
       "numberField_8"
      ],
      "align": true
     },
     {
      "id": "wp_box",
      "component": "Box",
      "children": [
       "row_5",
       "vectorField_6",
       "row_9"
      ],
      "align": false
     },
     {
      "id": "column_10",
      "component": "Column",
      "children": {
       "componentId": "wp_box",
       "path": "/waypoints"
      },
      "spacing": "small"
     },
     {
      "id": "scrollView_11",
      "component": "ScrollView",
      "child": "column_10",
      "rows": 16
     },
     {
      "id": "image_12",
      "component": "Image",
      "src": "assets/mission_map.svg",
      "height": 13,
      "fit": "cover",
      "alt": "Mission map"
     },
     {
