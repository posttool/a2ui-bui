     ],
     "milestones": [
      {
       "label": "Alpha components",
       "icon": "CHECKMARK",
       "description": "Oct 28"
      },
      {
       "label": "All 48 components",
       "icon": "TIME_CLOCK",
       "description": "Nov 12"
      },
      {
       "label": "Public demo",
       "icon": "FLAG",
       "description": "Nov 15"
      },
      {
       "label": "Catalog v1.1",
       "icon": "CALENDAR",
       "description": "Dec"
      }
     ],
     "notes": "Blockers: NodeEditor link hit-testing at 1.5× scale.\nDemo script lives in the shared doc."
    }
   }
  }
 ]
}
