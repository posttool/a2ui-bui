       "title": "Write showcase payloads",
       "owner": "jun",
       "due": "Done",
       "due_tone": "green",
       "priority": "Medium",
       "done": true
      },
      {
       "id": 3,
       "title": "Record demo video",
       "owner": "priya",
       "due": "Fri",
       "due_tone": "muted",
       "priority": "Low",
       "done": false
      },
      {
       "id": 4,
       "title": "Catalog JSON schema export",
       "owner": "maya",
       "due": "Overdue 2d",
       "due_tone": "red",
       "priority": "Urgent",
       "done": false
      },
      {
       "id": 5,
       "title": "Keyboard navigation for PieMenu",
       "owner": "sam",
       "due": "Mon",
       "due_tone": "muted",
       "priority": "Medium",
       "done": false
      },
      {
       "id": 6,
       "title": "Accessibility labels audit",
       "owner": "jun",
