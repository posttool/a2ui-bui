       "@path": "/history"
      },
      "rows": 6,
      "selected": {
       "@path": "/history_sel"
      },
      "filter": true,
      "action": {
       "event": {
        "name": "job_inspect",
        "context": {
         "index": {
          "@path": "/history_sel"
         }
        }
       }
      }
     },
