     {
      "id": "label_30",
      "component": "Label",
      "text": "Pool",
      "align": "right",
      "color": "muted"
     },
     {
      "id": "split_31",
      "component": "Split",
      "left": "label_30",
      "right": "dropdown_29",
      "factor": 0.4
     },
     {
      "id": "button_32",
      "component": "Button",
      "text": "Submit",
      "icon": "EXPORT",
      "depress": true,
      "action": {
       "event": {
        "name": "job_submit"
       }
      }
     },
     {
      "id": "popover_33",
      "component": "Popover",
