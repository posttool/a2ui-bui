       "column_6"
      ],
      "icon": "SEQUENCE"
     },
     {
      "id": "label_8",
      "component": "Label",
      "text": {
       "@path": "name"
      },
      "icon": "SERVER",
      "bold": true
     },
     {
      "id": "spacer_9",
      "component": "Spacer"
     },
     {
      "id": "label_10",
      "component": "Label",
      "text": {
       "@path": "state"
      },
      "color": {
       "@path": "color"
      },
      "size": "small"
     },
     {
      "id": "row_11",
      "component": "Row",
      "children": [
       "label_8",
       "spacer_9",
       "label_10"
      ]
     },
     {
      "id": "progressBar_12",
      "component": "ProgressBar",
      "value": {
       "@path": "cpu"
      },
      "text": {
       "@path": "cpu_text"
      }
     },
     {
      "id": "label_13",
      "component": "Label",
      "text": {
       "@path": "gpu"
      },
      "size": "small",
      "color": "muted"
     },
     {
      "id": "node_box",
      "component": "Box",
      "children": [
       "row_11",
       "progressBar_12",
       "label_13"
      ]
     },
     {
      "id": "grid_14",
      "component": "Grid",
      "columns": 3,
      "children": {
       "componentId": "node_box",
       "path": "/nodes"
      }
     },
     {
      "id": "panel_15",
      "component": "Panel",
      "title": "Workers",
      "children": [
       "grid_14"
      ],
      "icon": "NETWORK_DRIVE"
     },
     {
      "id": "listView_16",
