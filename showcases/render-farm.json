      "loop": true,
      "autoplay": true,
      "height": 10,
      "fit": "cover",
      "action": {
       "event": {
        "name": "preview_ended"
       }
      }
     },
     {
      "id": "pathField_18",
      "component": "PathField",
      "value": "//shots/sh040_lighting.blend",
