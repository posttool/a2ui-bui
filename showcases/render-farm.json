{
 "name": "Render farm monitor",
 "window": "Render Farm — studio queue",
 "width": 1100,
 "description": "Farm dashboard: a looping Video preview of the latest frame, a filterable ListView of finished jobs, queue rows templated from /jobs with per-job ProgressBars that later updateDataModel messages advance, a Grid of worker Boxes and a Submit Job popover.",
 "messages": [
  {
   "version": "v1.0",
   "createSurface": {
    "surfaceId": "main",
    "catalogId": "https://a2ui-bui-demo.local/catalogs/bui/v1/catalog.json",
    "sendDataModel": true
   }
  },
  {
   "version": "v1.0",
   "updateComponents": {
    "surfaceId": "main",
    "components": [
     {
      "id": "label_1",
      "component": "Label",
      "text": {
       "@path": "name"
      },
      "icon": {
       "@path": "icon"
      },
      "weight": 2.2
     },
     {
      "id": "progressBar_2",
      "component": "ProgressBar",
      "value": {
       "@path": "progress"
      },
      "text": {
       "@path": "status"
      },
      "weight": 3
     },
     {
      "id": "label_3",
      "component": "Label",
      "text": {
       "@path": "node"
      },
      "color": "muted",
      "size": "small",
      "weight": 1
     },
     {
      "id": "iconButton_4",
      "component": "IconButton",
      "icon": "PAUSE",
      "action": {
       "event": {
        "name": "job_pause",
        "context": {
         "job": {
          "@path": "id"
         }
        }
       }
      },
      "description": "Pause job"
     },
     {
      "id": "iconButton_5",
      "component": "IconButton",
      "icon": "X",
      "action": {
       "event": {
        "name": "job_cancel",
        "context": {
         "job": {
          "@path": "id"
         }
        }
       }
      },
      "description": "Cancel job"
     },
     {
      "id": "job_row",
      "component": "Row",
      "children": [
       "label_1",
       "progressBar_2",
       "label_3",
       "iconButton_4",
       "iconButton_5"
      ],
      "spacing": "small"
     },
     {
      "id": "column_6",
