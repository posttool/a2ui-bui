            "color": "muted"
          },
          {
            "id": "split_trig",
            "component": "Split",
            "left": "lbl_trig",
            "right": "drop_trig",
            "factor": 0.4
          },
          {
            "id": "num_overlap",
            "component": "NumberSlider",
            "value": {
              "@path": "/camera/overlap"
