          {
            "id": "lbl_overlap",
            "component": "Label",
            "text": "Front Overlap",
            "align": "right",
            "color": "muted"
          },
          {
            "id": "split_overlap",
            "component": "Split",
            "left": "lbl_overlap",
            "right": "num_overlap",
            "factor": 0.4
          },
          {
            "id": "num_sidelap",
            "component": "NumberSlider",
            "value": {
              "@path": "/camera/sidelap"
            },
            "min": 40,
            "max": 85,
            "suffix": "%",
            "precision": 0
          },
          {
            "id": "lbl_sidelap",
            "component": "Label",
            "text": "Side Overlap",
            "align": "right",
            "color": "muted"
          },
          {
            "id": "split_sidelap",
            "component": "Split",
            "left": "lbl_sidelap",
            "right": "num_sidelap",
            "factor": 0.4
          },
