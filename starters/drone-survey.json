{
  "prompt": "A drone survey mission planner: a list of waypoints with position, altitude and speed, a gimbal direction ball, camera settings, battery and flight-time estimate, the mission map image and Upload / Start buttons.",
  "meta": {
    "title": "Drone Survey Mission Planner",
    "width": 1080
  },
  "model": "gemini-3.8-flash",
  "ms": 99334,
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "main",
        "catalogId": "https://a2ui-bui-demo.local/catalogs/bui/v1/catalog.json",
        "sendDataModel": true
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "main",
        "value": {
          "drone": {
            "name": "Surveyor-X4 Pro",
            "status": "Ready · GPS 3D Fix (18 sats)",
            "battery": 0.88,
            "battery_text": "88% (22.4 V)",
            "flight_time": 18.4,
            "distance": 2450,
            "est_energy": 310,
            "gimbal_dir": [
              0,
              0.707,
              -0.707
            ]
          },
          "waypoints": [
            {
              "id": 1,
              "name": "WP 01 (Takeoff)",
              "alt": 15,
              "speed": 3.0,
              "action": "Hover"
            },
            {
              "id": 2,
              "name": "WP 02 (Grid Start)",
              "alt": 45,
              "speed": 8.0,
              "action": "Photo Trigger"
            },
            {
              "id": 3,
              "name": "WP 03 (Turn 1)",
              "alt": 45,
              "speed": 8.0,
              "action": "Photo Trigger"
            },
            {
              "id": 4,
              "name": "WP 04 (Grid Leg 2)",
              "alt": 45,
              "speed": 7.5,
              "action": "Photo Trigger"
            },
            {
              "id": 5,
              "name": "WP 05 (Turn 2)",
              "alt": 50,
              "speed": 6.0,
              "action": "Photo Trigger"
            },
            {
              "id": 6,
              "name": "WP 06 (RTH Point)",
              "alt": 30,
              "speed": 5.0,
              "action": "RTH"
            }
          ],
          "camera": {
            "sensor": "APS-C 24MP",
            "lens": "24mm f/2.8",
            "iso": "100",
            "shutter": "1/1000s",
            "interval": 2.0,
            "overlap": 75,
            "sidelap": 70,
            "trigger_mode": "Distance (12m)"
          },
          "mission": {
            "name": "North Ridge Topo Survey",
            "return_to_home": true,
            "obstacle_avoid": true,
            "terrain_follow": false
          }
        }
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "main",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": [
              "top_row",
              "main_content",
              "action_bar"
            ],
            "spacing": "small"
          },
          {
            "id": "drone_label",
            "component": "Label",
            "text": {
              "@path": "/drone/name"
            },
            "icon": "DRONE",
            "bold": true,
            "size": "large"
          },
          {
            "id": "status_label",
            "component": "Label",
            "text": {
              "@path": "/drone/status"
            },
            "icon": "CHECKMARK",
            "color": "green",
            "size": "small"
          },
          {
            "id": "spacer_top",
            "component": "Spacer"
          },
          {
            "id": "btn_sim",
            "component": "Button",
            "text": "Simulate Flight",
            "icon": "PLAY"
          },
          {
            "id": "btn_clear",
            "component": "Button",
            "text": "Clear Path",
            "icon": "TRASH"
          },
          {
            "id": "top_row",
            "component": "Row",
            "children": [
              "drone_label",
              "status_label",
              "spacer_top",
              "btn_sim",
              "btn_clear"
            ],
            "spacing": "normal"
          },
          {
            "id": "main_content",
            "component": "Row",
            "children": [
              "left_col",
              "right_col"
            ],
            "spacing": "small"
          },
          {
            "id": "left_col",
            "component": "Column",
            "children": [
              "panel_map",
              "panel_waypoints"
            ],
            "weight": 1.3,
            "spacing": "small"
          },
          {
            "id": "right_col",
            "component": "Column",
            "children": [
              "panel_flight_stats",
              "panel_gimbal",
              "panel_camera",
              "panel_safety"
            ],
            "weight": 0.9,
            "spacing": "small"
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "main",
        "components": [
          {
            "id": "map_img",
            "component": "Image",
            "src": "assets/mission_map.svg",
            "height": 11,
            "fit": "contain"
          },
          {
            "id": "panel_map",
            "component": "Panel",
            "title": "Survey Grid & Flight Path",
            "icon": "MAP",
            "children": [
              "map_img"
            ]
          },
          {
            "id": "wp_icon",
            "component": "Label",
            "text": "",
            "icon": "SNAP_VERTEX"
          },
          {
            "id": "wp_name",
            "component": "Label",
            "text": {
              "@path": "name"
            },
            "bold": true,
            "weight": 1
          },
          {
            "id": "wp_alt",
            "component": "NumberField",
            "value": {
              "@path": "alt"
            },
            "suffix": " m",
            "min": 5,
            "max": 120,
            "precision": 1,
            "weight": 0.7
          },
          {
            "id": "wp_speed",
            "component": "NumberField",
            "value": {
              "@path": "speed"
            },
            "suffix": " m/s",
            "min": 1,
            "max": 15,
            "precision": 1,
            "weight": 0.7
          },
          {
            "id": "wp_action",
            "component": "Label",
            "text": {
              "@path": "action"
            },
            "color": "muted",
            "size": "small",
            "weight": 0.8
          },
          {
            "id": "wp_row",
            "component": "Row",
            "children": [
              "wp_icon",
              "wp_name",
              "wp_alt",
              "wp_speed",
              "wp_action"
            ],
            "align": true,
            "spacing": "small"
          },
          {
            "id": "wp_list",
            "component": "Column",
            "children": {
              "componentId": "wp_row",
              "path": "/waypoints"
            },
            "spacing": "small"
          },
          {
            "id": "btn_add_wp",
            "component": "Button",
            "text": "Add Waypoint",
            "icon": "ADD"
          },
          {
            "id": "panel_waypoints",
            "component": "Panel",
            "title": "Waypoints (Position, Alt, Speed)",
            "icon": "LINCURVE",
            "children": [
              "wp_list",
              "btn_add_wp"
            ]
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "main",
        "components": [
          {
            "id": "batt_bar",
            "component": "ProgressBar",
            "value": {
              "@path": "/drone/battery"
            },
            "text": {
              "@path": "/drone/battery_text"
            }
          },
          {
            "id": "lbl_batt",
            "component": "Label",
            "text": "Battery Level",
            "align": "right",
            "color": "muted"
          },
          {
            "id": "split_batt",
            "component": "Split",
            "left": "lbl_batt",
            "right": "batt_bar",
            "factor": 0.4
          },
          {
            "id": "lbl_ft_val",
            "component": "Label",
            "text": "18.4 min (Est. 23 min max)",
            "icon": "TIME"
          },
          {
            "id": "lbl_ft",
            "component": "Label",
            "text": "Flight Time",
            "align": "right",
            "color": "muted"
          },
          {
            "id": "split_ft",
            "component": "Split",
            "left": "lbl_ft",
            "right": "lbl_ft_val",
            "factor": 0.4
          },
          {
            "id": "lbl_dist_val",
            "component": "Label",
            "text": "2.45 km · 6 Waypoints",
            "icon": "ROUTE"
          },
          {
            "id": "lbl_dist",
            "component": "Label",
            "text": "Total Path",
            "align": "right",
            "color": "muted"
          },
          {
            "id": "split_dist",
            "component": "Split",
            "left": "lbl_dist",
            "right": "lbl_dist_val",
            "factor": 0.4
          },
          {
            "id": "panel_flight_stats",
            "component": "Panel",
            "title": "Telemetry & Estimates",
            "icon": "BATTERY",
            "children": [
              "split_batt",
              "split_ft",
              "split_dist"
            ]
          },
          {
            "id": "gimbal_ball",
            "component": "NormalBall",
            "label": "Pitch / Yaw",
            "value": {
              "@path": "/drone/gimbal_dir"
            },
            "size": 4.5
          },
          {
            "id": "lbl_ball_hint",
            "component": "Label",
            "text": "Drag sphere to point camera nadir/oblique",
            "color": "muted",
            "size": "small",
            "align": "center"
          },
          {
            "id": "panel_gimbal",
            "component": "Panel",
            "title": "Gimbal Orientation",
            "icon": "ORIENTATION_LOCAL",
            "children": [
              "gimbal_ball",
              "lbl_ball_hint"
            ]
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "main",
        "components": [
          {
            "id": "drop_trig",
