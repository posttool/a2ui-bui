          },
          {
            "id": "lbl_iso",
            "component": "Label",
            "text": "ISO",
            "align": "right",
            "color": "muted"
          },
          {
            "id": "split_iso",
            "component": "Split",
            "left": "lbl_iso",
            "right": "drop_iso",
            "factor": 0.4
          },
          {
            "id": "drop_shutter",
            "component": "Dropdown",
            "value": {
              "@path": "/camera/shutter"
            },
            "items": [
              "1/500s",
              "1/1000s",
              "1/1600s",
              "1/2000s"
            ]
          },
          {
            "id": "lbl_shutter",
            "component": "Label",
            "text": "Shutter Speed",
            "align": "right",
            "color": "muted"
          },
          {
            "id": "split_shutter",
            "component": "Split",
            "left": "lbl_shutter",
            "right": "drop_shutter",
            "factor": 0.4
          },
          {
            "id": "panel_camera",
            "component": "Panel",
            "title": "Payload & Camera",
            "icon": "CAMERA",
            "children": [
              "split_trig",
              "split_overlap",
              "split_sidelap",
              "split_iso",
              "split_shutter"
            ],
            "collapsed": false
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "main",
        "components": [
          {
            "id": "chk_rth",
            "component": "Checkbox",
            "label": "Auto RTH on Low Battery (<20%)",
            "value": {
              "@path": "/mission/return_to_home"
            }
          },
          {
            "id": "chk_obs",
            "component": "Checkbox",
            "label": "Obstacle Avoidance Radar",
            "value": {
              "@path": "/mission/obstacle_avoid"
            }
          },
          {
            "id": "chk_tf",
            "component": "Checkbox",
            "label": "Terrain Following (LiDAR/DSM)",
            "value": {
              "@path": "/mission/terrain_follow"
            }
          },
          {
            "id": "panel_safety",
            "component": "Panel",
            "title": "Failsafe & Safety",
            "icon": "SHIELD",
            "children": [
              "chk_rth",
              "chk_obs",
              "chk_tf"
            ],
            "collapsed": true
          },
          {
            "id": "status_footer",
            "component": "Label",
            "text": "Pre-flight checks passed · Wind 2.1 m/s NW",
            "icon": "INFO",
            "color": "muted"
          },
          {
            "id": "spacer_bot",
            "component": "Spacer"
          },
          {
            "id": "btn_upload",
            "component": "Button",
            "text": "Upload Mission",
            "icon": "EXPORT",
            "action": {
              "event": {
                "name": "upload_mission"
              }
            }
          },
          {
            "id": "btn_start",
            "component": "Button",
            "text": "Arm & Start Mission",
            "icon": "CHECKBOX_HLT",
            "depress": true,
            "action": {
              "event": {
                "name": "start_mission"
              }
            }
          },
          {
            "id": "action_bar",
            "component": "Row",
            "children": [
              "status_footer",
              "spacer_bot",
              "btn_upload",
              "btn_start"
            ],
            "spacing": "normal"
          }
        ]
      }
